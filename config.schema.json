{
  "pluginAlias": "SolaxLocal",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Local Solax integration. Reads the dongle's local HTTP API (Pocket WiFi 3.0 / LAN) — no cloud, no TokenID.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Solax",
        "required": true
      },
      "model": {
        "title": "Inverter model",
        "type": "string",
        "default": "x3-hybrid-g4",
        "oneOf": [
          { "title": "X3 Hybrid G4 / G4 PRO", "enum": ["x3-hybrid-g4"] },
          { "title": "X1 Hybrid G4", "enum": ["x1-hybrid-g4"] }
        ],
        "description": "Selects the Data[] decoder. Add more models in index.js DECODERS."
      },
      "host": {
        "title": "Dongle IP address",
        "type": "string",
        "format": "hostname",
        "placeholder": "192.168.1.50",
        "required": true,
        "description": "IP of the Pocket WiFi 3.0 / LAN dongle on your LAN (set a DHCP reservation)."
      },
      "sn": {
        "title": "Dongle serial number (pwd)",
        "type": "string",
        "required": true,
        "description": "The Wi-Fi/LAN dongle registration number printed on its sticker (e.g. SWxxxxxxxx). Used as the API password."
      },
      "pollInterval": {
        "title": "Poll interval (seconds)",
        "type": "integer",
        "default": 15,
        "minimum": 5,
        "maximum": 300
      },
      "timeout": {
        "title": "Request timeout (seconds)",
        "type": "integer",
        "default": 8,
        "minimum": 2,
        "maximum": 30
      },
      "lowBattery": {
        "title": "Low battery threshold (%)",
        "type": "integer",
        "default": 15,
        "minimum": 0,
        "maximum": 100
      },
      "invertGrid": {
        "title": "Invert grid sign",
        "type": "boolean",
        "default": false,
        "description": "Enable if import/export appear swapped."
      },
      "invertBattery": {
        "title": "Invert battery sign",
        "type": "boolean",
        "default": false,
        "description": "Enable if charge/discharge appear swapped."
      },
      "debug": {
        "title": "Debug logging (log raw Data[])",
        "type": "boolean",
        "default": false
      },
      "triggers": {
        "title": "Automation triggers",
        "type": "array",
        "description": "Each trigger is an occupancy sensor that activates when a metric crosses a limit. Use it in HomeKit automations.",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true,
              "placeholder": "e.g. Solar surplus"
            },
            "metric": {
              "title": "Metric",
              "type": "string",
              "required": true,
              "default": "pv",
              "oneOf": [
                { "title": "Solar PV power (W)", "enum": ["pv"] },
                { "title": "House load (W)", "enum": ["load"] },
                { "title": "Grid import (W)", "enum": ["gridImport"] },
                { "title": "Grid export (W)", "enum": ["gridExport"] },
                { "title": "Battery charge (W)", "enum": ["battCharge"] },
                { "title": "Battery discharge (W)", "enum": ["battDischarge"] },
                { "title": "Battery SOC (%)", "enum": ["soc"] }
              ]
            },
            "above": {
              "title": "Activate when value is at or above",
              "type": "number"
            },
            "below": {
              "title": "Activate when value is at or below",
              "type": "number"
            },
            "hysteresis": {
              "title": "Hysteresis (avoids flapping near the limit)",
              "type": "number",
              "default": 0
            }
          }
        }
      }
    }
  }
}
